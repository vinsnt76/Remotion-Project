    "remotion": "remotion studio",
    "render": "remotion render",
    "render:slide1": "remotion render Slide1-Hook out/babybento/openshot/Slide1-Hook.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:slide2": "remotion render Slide2-Customization out/babybento/openshot/Slide2-Customization.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:slide3": "remotion render Slide3-Thermal out/babybento/openshot/Slide3-Thermal.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:slide4": "remotion render Slide4-Durability out/babybento/openshot/Slide4-Durability.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:slide5": "remotion render Slide5-Versatility out/babybento/openshot/Slide5-Versatility.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:slide6": "remotion render Slide6-CTA out/babybento/openshot/Slide6-CTA.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:master": "remotion render MontiiCoFusion-Master out/babybento/openshot/MontiiCoFusion-Master.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:all-slides": "npm run render:slide1 && npm run render:slide2 && npm run render:slide3 && npm run render:slide4 && npm run render:slide5 && npm run render:slide6",
    "render:omie": "remotion render BabyBentoOmieBlackFriday out/babybento/BabyBentoOmieBlackFriday.mp4 --codec=h264",
    "render:omie:1x1": "remotion render BabyBentoOmieBlackFriday-1x1 out/babybento/BabyBentoOmieBlackFriday-1x1.mp4 --codec=h264",
    "render:aeobility:16x9": "remotion render AEObility-Starter-16x9 out/aeobility/AEObility-Starter-16x9.mp4 --codec=h264",
    "render:aeobility:9x16": "remotion render AEObility-Starter-9x16 out/aeobility/AEObility-Starter-9x16.mp4 --codec=h264",
    "render:aeobility:1x1": "remotion render AEObility-Starter-1x1 out/aeobility/AEObility-Starter-1x1.mp4 --codec=h264",
